{
  "name": "@acertijosapps/electron-viewer",
  "version": "0.1.0",
  "description": "Visor web de apps Electron en vivo (screencast por CDP, input de mouse y teclado, captura con el marco nativo) y MCP para que un agente las maneje.",
  "type": "module",
  "main": "server.js",
  "bin": {
    "electron-viewer": "bin/electron-viewer.js"
  },
  "files": [
    "bin",
    "server.js",
    "lib",
    "mcp",
    "public",
    "media",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/electron-viewer.js",
    "mcp": "node bin/electron-viewer.js mcp",
    "example": "node bin/electron-viewer.js --project example",
    "check": "node --check bin/electron-viewer.js && node --check server.js && node --check lib/cdp.js && node --check lib/electron.js && node --check mcp/server.js && node --check public/viewer.js",
    "postinstall": "git config core.hooksPath .githooks || exit 0"
  },
  "keywords": [
    "electron",
    "cdp",
    "chrome-devtools-protocol",
    "screencast",
    "viewer",
    "automation",
    "mcp",
    "model-context-protocol",
    "claude-code"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acertijosapps/electron-viewer.git"
  },
  "author": "AcertijosApps <acertijos.contacto@gmail.com> (https://acertijosapps.com/librerias/)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/acertijosapps/electron-viewer/issues"
  },
  "homepage": "https://acertijosapps.com/librerias/",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "ws": "^8.18.0",
    "zod": "4.6.7"
  }
}
